  "private": true,
  "description": "A source-grounded Greek library and index, built one research bounty at a time.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
