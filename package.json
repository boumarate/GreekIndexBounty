    "test": "node --test tests/*.test.mjs",
    "export": "node scripts/export.mjs",
    "validate": "node scripts/validate.mjs",
    "submission": "node scripts/submission.mjs",
    "pr:body": "node scripts/submission.mjs body"
  }
}
